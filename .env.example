# ==============================================================================
# TATADANA FINTECH ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Gunakan panduan ini untuk mengatur kredensial produksi atau staging.
# Aplikasi memiliki fallback mode interaktif offline/mock bawaan sehingga
# dapat dijalankan dan diuji di localhost tanpa konfigurasi env awal.
# Standar Waktu: Asia/Jakarta (WIB, UTC+7) 100%
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL, Auth & Storage Configuration (Part 14.1, 14.2, 14.7)
# ------------------------------------------------------------------------------
# Dapatkan URL dan Key dari project settings di https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Buckets (Part 11.2 & Part 14.7)
# avatars: bucket publik untuk foto profil pengguna
# exports: bucket private dengan signed URL untuk berkas laporan PDF & Excel
SUPABASE_AVATARS_BUCKET=avatars
SUPABASE_EXPORTS_BUCKET=exports

# ------------------------------------------------------------------------------
# 2. Superadmin Onboarding & First Admin Setup (Part 14.3)
# ------------------------------------------------------------------------------
# Email superadmin resmi dosen yang otomatis terdaftar di tabel admin_emails
# Memiliki akses langsung ke Superadmin Console (/admin) tanpa approval / OTP
SUPERADMIN_EMAIL=putriayusagita02@gmail.com
# Daftar email admin tambahan (dipisahkan koma) jika ada
ADMIN_EMAILS=putriayusagita02@gmail.com

# ------------------------------------------------------------------------------
# 3. Telegram Bot Integration, Webhook & Telegram OTP Engine (Part 14.4)
# ------------------------------------------------------------------------------
# Username bot resmi Telegram (tanpa @) untuk deep-link registrasi & OTP
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=TataDanaBot
# Token bot didapatkan dari @BotFather di aplikasi Telegram
TELEGRAM_BOT_TOKEN=7128491234:AAEbXxK99-example-token-secure
# Secret token header untuk verifikasi webhook (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_BOT_SECRET_TOKEN=tatadana_secret_webhook_token_secure_2026
# Secret key untuk HMAC-SHA256 hashing kode OTP Telegram (Part 14.4)
TELEGRAM_OTP_SECRET=tatadana_super_secret_otp_hmac_key_2026_wib
# Domain publik aktif yang dapat diakses Telegram (Cloudflare tunnel / Ngrok)
WEBHOOK_BASE_URL=https://tatadana.vercel.app

# ------------------------------------------------------------------------------
# 4. Multi-Domain & Routing Configuration (Part 14.1)
# ------------------------------------------------------------------------------
# Domain User App (Dashboard, Registrasi, Landing Page)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USER_APP_URL=https://app.tatadana.id
# Subdomain Admin Console (Superadmin Persetujuan & Monitoring)
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.tatadana.id

# ------------------------------------------------------------------------------
# 5. Multi-Provider AI Engine (Gemini 2.0 Flash, OpenAI GPT, DeepSeek)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Default Utama Multimodal Vision & Teks)
GEMINI_API_KEY=your-gemini-api-key
# OpenAI API Key (Standby Failover)
OPENAI_API_KEY=your-openai-api-key
# DeepSeek API Key (Secondary Backup)
DEEPSEEK_API_KEY=your-deepseek-api-key

# ------------------------------------------------------------------------------
# 6. Midtrans Payment Gateway (QRIS, VA, & Kartu Kredit)
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 7. Timezone & Runtime Settings
# ------------------------------------------------------------------------------
# Seluruh kalkulasi & pelaporan menggunakan WIB (UTC+7)
TZ=Asia/Jakarta
NODE_ENV=development
